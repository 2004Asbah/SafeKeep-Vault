FROM python:3.11-slim

WORKDIR /app

# Copy frontend requirements
COPY frontendd/requirements.txt .

# Patch all OS-level CVEs (krb5, openssl, python3.11 etc.) before adding app code
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy frontend code
COPY frontendd/ ./frontendd/
COPY .streamlit/ ./.streamlit/

# Expose port
EXPOSE 8501

# Run Streamlit with PORT from environment (Render provides this)
# Enable CORS for cross-origin API calls
CMD streamlit run frontendd/app.py --server.port=${PORT:-8501} --server.address=0.0.0.0 --server.enableCORS=false --server.enableXsrfProtection=false

